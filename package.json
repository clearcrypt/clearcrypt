{
  "name": "clearcrypt",
  "version": "1.2.0",
  "description": "Client-side file encryption for browsers, Node.js and AI-agent workflows. Argon2id, AES-256-GCM, zero-knowledge design and offline decryption.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "main": "dist/index.js",
  "browser": "dist/browser.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/browser.js",
      "node": "./dist/index.js",
      "import": "./dist/browser.js",
      "default": "./dist/browser.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "node": "./dist/node.js",
      "import": "./dist/node.js",
      "default": "./dist/node.js"
    }
  },
  "files": [
    "benchmarks/argon2/browser",
    "dist",
    "SECURITY.md",
    "docs/format-v1.md",
    "docs/format-v2.md",
    "docs/argon2-profiles-v1.md",
    "docs/guide-v2.md",
    "docs/qualification-v2.md",
    "docs/results/qualification-v2-node-2026-10-04.json",
    "docs/memory-v1.md",
    "scripts/benchmark-argon2-v1.mjs",
    "scripts/benchmark-memory-v1.mjs",
    "scripts/benchmark-v2.mjs",
    "scripts/qualify-v2.mjs",
    "scripts/run-browser-qualification-v2.mjs",
    "scripts/cc-file.mjs",
    "scripts/cli-password.mjs",
    "scripts/private-file.mjs",
    "scripts/serve-argon2-benchmark.mjs",
    "scripts/verify-v1-vector.mjs",
    "scripts/verify-v2-vectors.mjs",
    "test/vectors/v1",
    "test/vectors/v2"
  ],
  "scripts": {
    "build": "tsup --config tsup.node.config.ts && tsup --config tsup.browser.config.ts",
    "check:browser-bundle": "node scripts/check-browser-bundle.mjs",
    "check:types": "tsc --noEmit",
    "check:package": "node scripts/check-package.mjs",
    "check:release-tag": "node scripts/check-release-tag.mjs",
    "test": "vitest",
    "test:run": "vitest run",
    "test:fuzz": "node scripts/run-parser-fuzz.mjs",
    "test:cli:v2": "node scripts/test-cli-v2.mjs",
    "test:browser": "playwright test",
    "test:browser:install": "playwright install --with-deps chromium firefox webkit",
    "benchmark:memory:v1": "node --expose-gc scripts/benchmark-memory-v1.mjs",
    "benchmark:v2": "node --expose-gc scripts/benchmark-v2.mjs",
    "qualify:node:v2": "node --expose-gc scripts/qualify-v2.mjs",
    "qualify:browser:v2": "node scripts/run-browser-qualification-v2.mjs",
    "benchmark:argon2:v1": "node --expose-gc scripts/benchmark-argon2-v1.mjs",
    "benchmark:argon2:browser": "node scripts/serve-argon2-benchmark.mjs",
    "test:vector:v1": "node scripts/verify-v1-vector.mjs",
    "test:vector:v2": "node scripts/verify-v2-vectors.mjs",
    "release:check": "npm run build && npm run check:types && npm run test:run && npm run test:cli:v2 && npm run test:vector:v1 && npm run test:vector:v2 && npm run check:browser-bundle && npm run test:browser && npm run check:package",
    "release:publish": "npm publish --access public --provenance"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/clearcrypt/clearcrypt.git"
  },
  "keywords": [
    "file-encryption",
    "client-side-encryption",
    "browser-encryption",
    "local-encryption",
    "zero-knowledge",
    "password-based-encryption",
    "authenticated-encryption",
    "envelope-encryption",
    "aes-gcm",
    "aes-256-gcm",
    "argon2id",
    "webcrypto",
    "cryptography",
    "encrypted-archive",
    "encrypted-file-format",
    "offline-decryption",
    "pre-upload-encryption",
    "backup-encryption",
    "privacy",
    "security",
    "typescript",
    "nodejs",
    "browser",
    "ai-agent",
    "agentic-workflows",
    "automation"
  ],
  "author": "Khandova",
  "license": "AGPL-3.0",
  "allowScripts": {
    "esbuild@0.27.2": true,
    "fsevents": false
  },
  "bugs": {
    "url": "https://github.com/clearcrypt/clearcrypt/issues"
  },
  "homepage": "https://github.com/clearcrypt/clearcrypt#readme",
  "dependencies": {
    "argon2-browser": "1.18.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^25.0.3",
    "esbuild": "0.28.2",
    "fast-check": "4.10.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  }
}
