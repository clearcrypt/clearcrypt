{
  "name": "clearcrypt",
  "version": "1.0.0",
  "description": "Client-side, zero-knowledge file encryption core. This repository provides an auditable cryptographic core for encrypting and decrypting files locally using a password-based model. No plaintext, secrets, or keys are ever stored or transmitted. Includes a versioned, self-describing file format.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs/format-v1.md",
    "docs/memory-v1.md",
    "scripts/benchmark-memory-v1.mjs",
    "scripts/cc-file.mjs",
    "scripts/cli-password.mjs",
    "scripts/verify-v1-vector.mjs",
    "test/vectors/v1"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "check:types": "tsc --noEmit",
    "check:package": "node scripts/check-package.mjs",
    "check:release-tag": "node scripts/check-release-tag.mjs",
    "test": "vitest",
    "test:run": "vitest run",
    "benchmark:memory:v1": "node --expose-gc scripts/benchmark-memory-v1.mjs",
    "test:vector:v1": "node scripts/verify-v1-vector.mjs",
    "release:check": "npm run check:types && npm run test:run && npm run test:vector:v1 && npm run build && npm run check:package",
    "release:publish": "npm publish --access public --provenance"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/clearcrypt/clearcrypt.git"
  },
  "keywords": [
    "encrypt",
    "file",
    "crypt"
  ],
  "author": "Khandova",
  "license": "AGPL-3.0",
  "allowScripts": {
    "esbuild@0.27.2": true,
    "fsevents": false
  },
  "bugs": {
    "url": "https://github.com/clearcrypt/clearcrypt/issues"
  },
  "homepage": "https://github.com/clearcrypt/clearcrypt#readme",
  "dependencies": {
    "argon2-browser": "^1.18.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  }
}
